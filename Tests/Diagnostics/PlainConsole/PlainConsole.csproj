<Project Sdk="Microsoft.NET.Sdk">

	<!--
	  The smallest possible Windows-target executable. No xUnit, no packages, no native payload -
	  only the target framework and runtime identifier that WebRTCme.DeviceTests uses.

	  If this hangs on a runner, the fault is the target framework, the runtime identifier or the
	  apphost on that image, and nothing to do with the test framework.
	-->

	<PropertyGroup>
		<TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<OutputType>Exe</OutputType>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

</Project>
