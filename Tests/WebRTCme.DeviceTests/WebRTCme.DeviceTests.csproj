<Project Sdk="Microsoft.NET.Sdk">

	<!--
	  Tier 3 of doc/TestingPlan.md: does the package actually work at runtime, on this platform?

	  Tiers 1 and 2 are both managed-only. Nothing in them has loaded libwebrtc.aar,
	  WebRTC.framework or WebRtcInterop.dll - a package whose native payload is missing, or built
	  for the wrong architecture, passes every one of them. This is the tier that finds that out.

	  The test is loopback: two RTCPeerConnections in the same process, offer and answer and ICE
	  candidates handed between them in code. No signalling server, no second machine, no network,
	  no camera, no UI. It proves the native half loaded, that SDP marshals both ways, that ICE
	  candidates survive the round trip, and that DTLS and SCTP complete.

	  Like tier 2 this references the PACKAGE, never the projects, because testing the repository
	  would miss exactly the packaging faults this exists to catch. Run it through
	  Tests/Test-Device.ps1, which supplies the version and the feed.

	  One target framework at a time, by design: this is a process that runs on the machine it is
	  built for. That is Windows and only Windows today - see the target framework below for why
	  Mac Catalyst cannot run as a plain test process, and doc/TestingPlan.md phase 4 for what it
	  needs instead, along with Android and iOS.
	-->

	<PropertyGroup>
		<!--
		  Set here rather than passed in, because passing it does not work: -f and
		  -p:TargetFramework are honoured by the build but not by the implicit restore, which
		  resolves the project's declared framework instead, and the build then fails with NETSDK1005
		  saying the assets file has no target for the one it was given.

		  Windows only, and Mac Catalyst is not merely absent - it cannot work this way. Catalyst
		  builds an .app rather than an executable, and xUnit v3 refuses to build a test project
		  without an app host:

		    error : xUnit.net v3 test projects must build an app host ('<UseAppHost>true</UseAppHost>')
		    error NETSDK1084: no application host available for the RuntimeIdentifier 'maccatalyst-x64'

		  Setting UseAppHost is what produces the second, so the two cannot both be satisfied. Mac
		  Catalyst needs the same device runner as Android and iOS: it belongs to phase 4 of
		  doc/TestingPlan.md, which had put it in phase 3 on the assumption that a Catalyst process
		  runs like a Windows one. It does not.
		-->
		<TargetFramework Condition="'$(TargetFramework)' == '' AND $([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.22621.0</TargetFramework>

		<OutputType>Exe</OutputType>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>

		<!--
		  The native payload lives at runtimes/win-x64/native/WebRtcInterop.dll inside the package,
		  and NuGet only lays a runtime-specific asset next to the executable when the build knows
		  which runtime it is for. Without this the managed half loads and the first P/Invoke throws
		  DllNotFoundException - which is a real failure mode of the package, but not one worth
		  reproducing by misconfiguring the consumer.
		-->
		<RuntimeIdentifier Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">win-x64</RuntimeIdentifier>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.22621.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>

	</PropertyGroup>

	<PropertyGroup>
		<WebRTCmePackageVersion Condition="'$(WebRTCmePackageVersion)' == ''">$(WEBRTCME_PACKAGE_VERSION)</WebRTCmePackageVersion>
	</PropertyGroup>

	<Target Name="RequirePackageVersion" BeforeTargets="CollectPackageReferences">
		<Error Condition="'$(WebRTCmePackageVersion)' == ''"
		       Text="Set the package version to test: -p:WebRTCmePackageVersion=26.9.9, or the WEBRTCME_PACKAGE_VERSION environment variable. Tests/Test-Device.ps1 does both." />
	</Target>

	<ItemGroup>
		<PackageReference Include="AwesomeAssertions" Version="9.6.0" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
		<PackageReference Include="xunit.v3" Version="4.0.1" />
		<PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="WebRTCme" Version="$(WebRTCmePackageVersion)" />
	</ItemGroup>

	<!--
	  The scenarios themselves, shared with the device runner app that carries them onto Android,
	  iOS and Mac Catalyst. This project is only their xUnit face, so that a platform cannot end up
	  testing something subtly different from the others.
	-->
	<ItemGroup>
		<ProjectReference Include="..\WebRTCme.DeviceTests.Core\WebRTCme.DeviceTests.Core.csproj" />
	</ItemGroup>

	<!-- The version a MAUI consumer has to name itself; see WebRTCme.PackageTests for why. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != ''">
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.101" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.101" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
		<Using Include="AwesomeAssertions" />
	</ItemGroup>

</Project>
