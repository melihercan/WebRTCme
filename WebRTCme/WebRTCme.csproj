<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net10.0;net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.22621.0</TargetFrameworks>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">28.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.22621.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
		<GeneratePackageOnBuild>False</GeneratePackageOnBuild>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(TargetFramework)' == 'net10.0-android'">
		<UseMaui>true</UseMaui>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
		<UseMaui>true</UseMaui>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.22621.0'">
		<UseMaui>true</UseMaui>
	</PropertyGroup>


	<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-maccatalyst'">
		<UseMaui>true</UseMaui>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<Compile Include="**\Blazor\**\*.cs" />
		<Compile Include="*.cs" />
		<ProjectReference Include="..\WebRTCme.Bindings\WebRTCme.Bindings.Blazor\WebRTCme.Bindings.Blazor.csproj" />
		<PackageReference Include="Microsoft.JSInterop" Version="10.0.9" />
		<!--<PackageReference Include="Xamarin.Essentials" Version="1.8.1" />-->
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
		<Compile Include="**\Android\**\*.cs" />
		<Compile Include="*.cs" />
		<ProjectReference Include="..\WebRTCme.Bindings\Maui\WebRTCme.Bindings.Maui.Android\WebRTCme.Bindings.Maui.Android.csproj" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.80" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.80" />
		<PackageReference Include="Microsoft.JSInterop" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
		<Compile Include="**\iOS\**\*.cs" />
		<Compile Include="*.cs" />
		<ProjectReference Include="..\WebRTCme.Bindings\Maui\WebRTCme.Bindings.Maui.iOS\WebRTCme.Bindings.Maui.iOS.csproj" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.80" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.80" />
		<PackageReference Include="Microsoft.JSInterop" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.22621.0'">
		<Compile Include="**\Windows\**\*.cs" />
		<Compile Include="*.cs" />
		<Compile Include="**\Shared\SipSorcery\**\*.cs" />
		<ProjectReference Include="..\WebRTCme.Bindings\WebRTCme.Bindings.SipSorcery\WebRTCme.Bindings.SipSorcery.csproj" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.80" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.80" />
		<PackageReference Include="Microsoft.JSInterop" Version="10.0.0" />
		<!-- Windows media capture endpoints for the SipSorcery binding. Windows-only TFM,
		     hence referenced here rather than from WebRTCme.Bindings.SipSorcery (net10.0). -->
		<PackageReference Include="SIPSorceryMedia.Windows" Version="10.0.16" />
		<PackageReference Include="SIPSorceryMedia.FFmpeg" Version="10.0.16" />
	</ItemGroup>

	<!--
	  Mac Catalyst uses the native Google WebRTC framework, like iOS, rather than the SipSorcery
	  binding. FFmpeg.AutoGen misidentifies Catalyst as Linux (it looks for libdl.so.2), so the
	  SipSorcery route cannot encode or decode video there at all; the native framework also
	  brings camera, microphone and audio playback for free.
	-->
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-maccatalyst'">
		<Compile Include="**\MacCatalyst\**\*.cs" />
		<Compile Include="*.cs" />
		<ProjectReference Include="..\WebRTCme.Bindings\Maui\WebRTCme.Bindings.Maui.MacCatalyst\WebRTCme.Bindings.Maui.MacCatalyst.csproj" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.80" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.80" />
		<PackageReference Include="Microsoft.JSInterop" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\WebRTCme.Api\WebRTCme.Api.csproj" />
	</ItemGroup> 	

	<ItemGroup>
	  <None Include="..\me.png" Link="me.png">
		<PackagePath></PackagePath>
		<Pack>True</Pack>
	  </None>
	</ItemGroup> 	

	<!--
	  Make every platform's source files visible in Solution Explorer
	  regardless of which TFM is currently active. Files that are already
	  part of <Compile> for the active TFM are excluded so they are not
	  listed twice. bin/obj are excluded by the SDK's default None excludes.
	-->
	<ItemGroup>
		<None Include="Platforms\**\*.cs" Exclude="@(Compile)" />
		<None Include="Shared\**\*.cs" Exclude="@(Compile)" />
	</ItemGroup>

</Project>
