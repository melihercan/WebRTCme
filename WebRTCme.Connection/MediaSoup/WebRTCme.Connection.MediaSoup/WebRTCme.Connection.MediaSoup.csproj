<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Packed into WebRTCme or WebRTCme.Middleware, never shipped as a package of its own. -->
		<IsPackable>false</IsPackable>
		<TargetFrameworks>net10.0</TargetFrameworks>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="WebsocketClientLite.PCL" Version="9.1.0" />
		<PackageReference Include="System.Reactive" Version="7.0.0" />
		<PackageReference Include="Utilme.Result" Version="26.9.14" />
		<PackageReference Include="Utilme.SdpTransform" Version="26.9.14" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
		<PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.101" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\WebRTCme\WebRTCme.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!--
		  H264 and CommonUtils are internal to this assembly - they are implementation detail of the
		  mediasoup-client port, not surface anyone consumes - but they are pure functions over the
		  SDP wire format and are exactly what unit tests are for. Granting the test project access
		  is preferable to widening them to public purely to be testable.
		-->
		<InternalsVisibleTo Include="WebRTCme.Tests" />
	</ItemGroup>

</Project>
