<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
		<!-- Packed into WebRTCme or WebRTCme.Middleware, never shipped as a package of its own. -->
		<IsPackable>false</IsPackable>
    <TargetFrameworks>net10.0</TargetFrameworks>
  </PropertyGroup>


	<ItemGroup>
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.9" />
    <PackageReference Include="System.Reactive" Version="6.1.0" />
    <PackageReference Include="Utilme.Result" Version="1.0.1" />
    <PackageReference Include="Utilme.SdpTransform" Version="1.0.0" />
  </ItemGroup>


	<ItemGroup>
	  <ProjectReference Include="..\..\..\WebRTCme\WebRTCme.csproj" />
	  <!-- WebRTCme keeps its Api reference private so the package does not depend on it, so the API types have to be referenced here directly. -->
	  <ProjectReference Include="..\..\..\WebRTCme.Api\WebRTCme.Api.csproj" />
	</ItemGroup>

</Project>
