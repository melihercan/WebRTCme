<?xml version="1.0" encoding="UTF-8"?>
<StackLayout xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WebRTCme.DemoApp.Maui.Views.OutgoingChatView">

    <Grid ColumnDefinitions="64,*">
        <Border Grid.Column="1" HorizontalOptions="End" Margin="12,4"
                Padding="12,8"
                BackgroundColor="{StaticResource Primary}"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="2">
                <Label Text="{Binding Object.Text}" TextColor="{StaticResource TextPrimary}" />
                <Label Text="{Binding Time}" HorizontalOptions="End" FontSize="10"
                       TextColor="{StaticResource TextPrimary}" Opacity="0.7" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</StackLayout>
