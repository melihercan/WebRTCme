<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:extensions="clr-namespace:WebRTCme.DemoApp.Maui.Extensions"
             Title="About"
             x:Class="WebRTCme.DemoApp.Maui.Views.AboutPage">

    <Border Margin="16"
            Padding="32"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            MaximumWidthRequest="420"
            BackgroundColor="{StaticResource SurfaceRaised}"
            StrokeThickness="0">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12" />
        </Border.StrokeShape>

        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
            <Label Text="WebRTCme" FontSize="28" FontAttributes="Bold"
                   HorizontalTextAlignment="Center" />
            <Label Text="Demo application" Style="{StaticResource SecondaryLabel}"
                   HorizontalTextAlignment="Center" />

            <Image Aspect="AspectFit" HeightRequest="160" Margin="0,24"
                   Source="{extensions:ImageResourceMarkupExtension WebRTCme.DemoApp.Maui.Images.me.png}" />

            <Label Text="&#169; melihercan" Style="{StaticResource SecondaryLabel}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Border>
</ContentPage>
