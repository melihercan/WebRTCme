<?xml version="1.0" encoding="UTF-8"?>
<StackLayout xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WebRTCme.DemoApp.Maui.Views.IncomingChatView">

    <Grid ColumnDefinitions="*,64">
        <Border Grid.Column="0" HorizontalOptions="Start" Margin="12,4"
                Padding="12,8"
                BackgroundColor="{StaticResource SurfaceSunken}"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="2">
                <Label Text="{Binding PeerUserName}" FontSize="11" FontAttributes="Bold"
                       TextColor="{StaticResource TextSecondary}" />
                <Label Text="{Binding Object.Text}" TextColor="{StaticResource TextPrimary}" />
                <Label Text="{Binding Time}" HorizontalOptions="End" FontSize="10"
                       TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</StackLayout>
