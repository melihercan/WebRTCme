{
  "SignalingServer": {
    "BaseUrl": "https://192.168.1.48:5053"
  },
  "MediaSoupServer": {
    "BaseUrl": "wss://192.168.1.48:4443",
    // Off deliberately, and only in the demo apps - the library still supports it. With simulcast
    // on, the SFU parks a native consumer on spatial layer 0 and flaps: measured at 64-159 kbit/s
    // and 289x240 against 1781-1828 kbit/s and 578x480 with a single layer, over the same LAN.
    // See "The SFU will not climb past the bottom layer" in doc/KnownGaps.md.
    "UseSimulcast": false,
    "UseSharingSimulcast": true,
    // Asks the server for its own view of each consumer and of the receive transport,
    // logged raw. Two extra requests per sample, so on only while chasing something -
    // it is what showed the SFU's availableOutgoingBitrate collapsing to 47 kbit/s.
    "LogServerStats": false,
    "ForceTcp": false,
    "Produce": true,
    "Consume": true,
    "ForceH264": false,
    "ForceVP9": false,
    "Svc": false,
    "UseDataChannel": true,
    "E2eKey": null,
    "AudioOnly": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "System": "Warning",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore.SignalR": "Warning",
      "Microsoft.AspNetCore.Http.Connections": "Warning"
    }
  },
  "XAMARIN_ENVIRONMENT": "Development"
}
