<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.22621.0</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <RootNamespace>WebRTCme.DemoApp.Maui</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>

        <!-- Display name -->
        <ApplicationTitle>WebRTCme.DemoApp.Maui</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.companyname.webrtcme.demoapp.maui</ApplicationId>
        <ApplicationIdGuid>3D60F9C0-02BD-427F-9DED-82EDCEE7EF30</ApplicationIdGuid>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">28.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.22621.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
	</PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)'=='net8.0-ios'">
      <ProvisioningType>automatic</ProvisioningType>
      <CodesignKey>Apple Development: Created via API (C8LAPR9V66)</CodesignKey>
      <CodesignProvision>VS: WildCard Development</CodesignProvision>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)'=='net10.0-ios'">
      <CodesignKey>Apple Development: Created via API (4BFWRL9XBN)</CodesignKey>
      <CodesignProvision>VS: WildCard Development</CodesignProvision>
    </PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>
	<ItemGroup>
	  <None Remove="appsettings.json" />
	</ItemGroup>
	<ItemGroup>
	  <EmbeddedResource Include="appsettings.json" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.JSInterop" Version="10.0.9" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.80" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.80" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
		<PackageReference Include="Xamarinme.Configuration" Version="1.0.2" />
	</ItemGroup>
    
    <ItemGroup>
      <ProjectReference Include="..\..\WebRTCme.Middleware\WebRTCme.Middleware.Maui\WebRTCme.Middleware.Maui.csproj" />
    </ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
		<PackageReference Include="CommunityToolkit.Maui" Version="14.2.0" />
		<PackageReference Include="Xamarin.AndroidX.Fragment" Version="1.8.9.3" />
		<PackageReference Include="Xamarin.AndroidX.Camera.Lifecycle" Version="1.6.1.1" />
		<PackageReference Include="Xamarin.AndroidX.Camera.Camera2" Version="1.6.1.1" />
		<PackageReference Include="Xamarin.AndroidX.Camera.View" Version="1.6.1.1" />
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.8.9.4" />		
		<PackageReference Include="Xamarin.Google.Guava.ListenableFuture" Version="9999.0.0" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
		<PackageReference Include="CommunityToolkit.Maui" Version="14.2.0" />
	</ItemGroup>

	<!--
	  Windows video needs the FFmpeg 8.x *shared* native libraries at runtime; the
	  SIPSorceryMedia.FFmpeg package provides bindings only. They are not committed here
	  (~100MB, and LGPL binaries are better tracked outside the repo), so point
	  FFMPEG_SHARED_PATH at the folder holding avcodec-*.dll etc. and they are copied to the
	  output on build. Alternatively put that folder on PATH, or set
	  WindowsSupport.FFmpegLibraryPath at startup.
	-->
	<PropertyGroup Condition="'$(FFmpegSharedPath)' == ''">
		<FFmpegSharedPath>$(FFMPEG_SHARED_PATH)</FFmpegSharedPath>
	</PropertyGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.22621.0'
	                      And '$(FFmpegSharedPath)' != '' And Exists('$(FFmpegSharedPath)')">
		<None Include="$(FFmpegSharedPath)\*.dll" CopyToOutputDirectory="PreserveNewest"
		      Visible="false" />
	</ItemGroup>

</Project>
