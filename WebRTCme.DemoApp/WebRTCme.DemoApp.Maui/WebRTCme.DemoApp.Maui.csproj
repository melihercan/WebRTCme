<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.22621.0</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <RootNamespace>WebRTCme.DemoApp.Maui</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>

        <!-- Display name -->
        <ApplicationTitle>WebRTCme.DemoApp.Maui</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.companyname.webrtcme.demoapp.maui</ApplicationId>
        <ApplicationIdGuid>3D60F9C0-02BD-427F-9DED-82EDCEE7EF30</ApplicationIdGuid>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">28.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.22621.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
	</PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)'=='net8.0-ios'">
      <ProvisioningType>automatic</ProvisioningType>
      <CodesignKey>Apple Development: Created via API (C8LAPR9V66)</CodesignKey>
      <CodesignProvision>VS: WildCard Development</CodesignProvision>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)'=='net10.0-ios'">
      <CodesignKey>Apple Development: Created via API (4BFWRL9XBN)</CodesignKey>
      <CodesignProvision>VS: WildCard Development</CodesignProvision>
    </PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>
	<ItemGroup>
	  <None Remove="appsettings.json" />
	</ItemGroup>
	<ItemGroup>
	  <EmbeddedResource Include="appsettings.json" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.JSInterop" Version="10.0.9" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.80" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.80" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
		<PackageReference Include="Xamarinme.Configuration" Version="1.0.2" />
	</ItemGroup>
    
    <ItemGroup>
      <ProjectReference Include="..\..\WebRTCme.Middleware\WebRTCme.Middleware.Maui\WebRTCme.Middleware.Maui.csproj" />
    </ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
		<PackageReference Include="CommunityToolkit.Maui" Version="14.2.0" />
		<PackageReference Include="Xamarin.AndroidX.Fragment" Version="1.8.9.3" />
		<PackageReference Include="Xamarin.AndroidX.Camera.Lifecycle" Version="1.6.1.1" />
		<PackageReference Include="Xamarin.AndroidX.Camera.Camera2" Version="1.6.1.1" />
		<PackageReference Include="Xamarin.AndroidX.Camera.View" Version="1.6.1.1" />
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.8.9.4" />		
		<PackageReference Include="Xamarin.Google.Guava.ListenableFuture" Version="9999.0.0" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
		<PackageReference Include="CommunityToolkit.Maui" Version="14.2.0" />
	</ItemGroup>

	<!--
	  Windows video needs the FFmpeg 8.x *shared* native libraries at runtime;
	  SIPSorceryMedia.FFmpeg provides bindings only. They are not committed (137MB, and all
	  seven libraries are required - FFmpeg.AutoGen loads the whole set on init), so the build
	  resolves them in this order:

	    1. FFmpegSharedPath property        (-p:FFmpegSharedPath=...)
	    2. FFMPEG_SHARED_PATH environment variable
	    3. C:\apps\ffmpeg-8.1-shared\bin      (conventional local install)
	    4. a per-user cache, downloaded once from the FFmpeg build below

	  Whatever resolves first is copied next to the app on build. Set
	  FFmpegAllowDownload=false to disable step 4 and fail loudly instead, or set
	  WindowsSupport.FFmpegLibraryPath at startup to bypass all of this.

	  The build is the LGPL shared variant so that redistributing it alongside this
	  MIT-licensed library stays straightforward; its LICENSE.txt travels in the archive.
	-->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.22621.0'">
		<FFmpegBuildName>ffmpeg-n8.1-latest-win64-lgpl-shared-8.1</FFmpegBuildName>
		<FFmpegDownloadUrl>https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/$(FFmpegBuildName).zip</FFmpegDownloadUrl>
		<FFmpegCacheRoot>$(LOCALAPPDATA)\WebRTCme\ffmpeg</FFmpegCacheRoot>
		<FFmpegAllowDownload Condition="'$(FFmpegAllowDownload)' == ''">true</FFmpegAllowDownload>

		<FFmpegSharedPath Condition="'$(FFmpegSharedPath)' == ''">$(FFMPEG_SHARED_PATH)</FFmpegSharedPath>
		<FFmpegSharedPath Condition="'$(FFmpegSharedPath)' == '' And Exists('C:\apps\ffmpeg-8.1-shared\bin')">C:\apps\ffmpeg-8.1-shared\bin</FFmpegSharedPath>
		<FFmpegSharedPath Condition="'$(FFmpegSharedPath)' == '' And Exists('$(FFmpegCacheRoot)\$(FFmpegBuildName)\bin')">$(FFmpegCacheRoot)\$(FFmpegBuildName)\bin</FFmpegSharedPath>
	</PropertyGroup>

	<Target Name="ResolveFFmpegNatives" BeforeTargets="Build;Publish"
	        Condition="'$(TargetFramework)' == 'net10.0-windows10.0.22621.0'">

		<!-- Nothing found locally: fetch once into the per-user cache. -->
		<PropertyGroup Condition="'$(FFmpegSharedPath)' == '' And '$(FFmpegAllowDownload)' == 'true'">
			<FFmpegSharedPath>$(FFmpegCacheRoot)\$(FFmpegBuildName)\bin</FFmpegSharedPath>
		</PropertyGroup>

		<Message Importance="high" Condition="'$(FFmpegSharedPath)' != '' And !Exists('$(FFmpegSharedPath)')"
		         Text="Downloading FFmpeg shared libraries (~68MB) to $(FFmpegCacheRoot) - one time only." />
		<DownloadFile Condition="'$(FFmpegSharedPath)' != '' And !Exists('$(FFmpegSharedPath)')"
		              SourceUrl="$(FFmpegDownloadUrl)" DestinationFolder="$(FFmpegCacheRoot)"
		              SkipUnchangedFiles="true" Retries="2">
			<Output TaskParameter="DownloadedFile" PropertyName="FFmpegDownloadedArchive" />
		</DownloadFile>
		<Unzip Condition="'$(FFmpegDownloadedArchive)' != ''"
		       SourceFiles="$(FFmpegDownloadedArchive)" DestinationFolder="$(FFmpegCacheRoot)"
		       OverwriteReadOnlyFiles="true" />

		<Error Condition="'$(FFmpegSharedPath)' == ''"
		       Text="FFmpeg shared libraries not found and downloading is disabled. Set FFmpegSharedPath or FFMPEG_SHARED_PATH to a folder containing avcodec-*.dll." />

		<ItemGroup>
			<FFmpegNative Include="$(FFmpegSharedPath)\*.dll" />
		</ItemGroup>
		<Copy SourceFiles="@(FFmpegNative)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
	</Target>

</Project>
