@using WebRTCme.DemoApp.Blazor.Theme

@* Dark, always. See the note on DemoTheme. *@
<MudThemeProvider Theme="@DemoTheme.Instance" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <MudAlert Severity="Severity.Warning" Class="ma-8">
                There is nothing at this address.
            </MudAlert>
        </LayoutView>
    </NotFound>
</Router>

@* A central place to keep the popup list from Middleware.Blazor. *@
<GenericPopup />
