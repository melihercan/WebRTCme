@page "/ChatPage"
@page "/ChatPage/{ConnectionParametersJson}"
@using WebRTCme.Middleware
@layout BlankLayout

<PageTitle>WebRTCme - chat</PageTitle>

<div class="chat">

    <div class="drop">
        @*
            The file input covers the whole zone at zero opacity, so the panel below is what the
            pointer actually hits. Keeping it a plain InputFile rather than MudFileUpload leaves
            the existing multi-file handler untouched.
        *@
        <InputFile OnChange="@LoadFilesAsync" multiple class="drop-input" />
        <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Large" Color="Color.Default" />
        <MudText Typo="Typo.body2" Class="mud-text-secondary">@status</MudText>
    </div>

    <div class="messages">
        @foreach (var dataParameters in ChatViewModel.DataParametersList)
        {
            @if (dataParameters.Object is Message message)
            {
                <div class="row @RowClass(dataParameters.From)">
                    <MudPaper Elevation="0" Class="@BubbleClass(dataParameters.From)">
                        @if (dataParameters.From == DataFromType.Incoming)
                        {
                            <div class="who">@dataParameters.PeerUserName</div>
                        }
                        <div class="text">@message.Text</div>
                        <div class="when">@dataParameters.Time</div>
                    </MudPaper>
                </div>
            }
        }
    </div>

    <div class="composer">
        <EditForm Model="@ChatViewModel" OnValidSubmit="@ChatViewModel.SendMessageAsync">
            <DataAnnotationsValidator />
            <div class="composer-row">
                <MudTextField @bind-Value="ChatViewModel.OutgoingText"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Placeholder="Write a message" Immediate="true"
                              Class="composer-field" />
                <MudIconButton ButtonType="ButtonType.Submit"
                               Icon="@Icons.Material.Filled.Send"
                               Color="Color.Primary" Variant="Variant.Filled"
                               aria-label="Send" />
            </div>
        </EditForm>
    </div>
</div>

@code {
    static string RowClass(DataFromType from) => from switch
    {
        DataFromType.Outgoing => "row-outgoing",
        DataFromType.System => "row-system",
        _ => "row-incoming",
    };

    static string BubbleClass(DataFromType from) => from switch
    {
        DataFromType.Outgoing => "bubble bubble-outgoing",
        DataFromType.System => "bubble bubble-system",
        _ => "bubble bubble-incoming",
    };
}
