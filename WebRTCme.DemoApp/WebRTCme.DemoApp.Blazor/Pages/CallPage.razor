@page "/CallPage"
@page "/CallPage/{ConnectionParametersJson}"
@layout BlankLayout

<h1 class="text-center">Call</h1>
<button type="button" class="m-2 btn btn-secondary" @onclick="@CallViewModel.OnShareScreenAsync">
    @CallViewModel.ShareScreenButtonText
</button>

<button type="button" class="m-2 btn btn-secondary" @onclick="@CallViewModel.OnRecordAsync">
    @CallViewModel.RecordButtonText
</button>

<button type="button" class="m-2 btn btn-secondary" @onclick="@CallViewModel.OnToggleMicrophoneAsync">
    @CallViewModel.MicrophoneButtonText
</button>

<button type="button" class="m-2 btn btn-secondary" @onclick="@CallViewModel.OnToggleCameraAsync">
    @CallViewModel.CameraButtonText
</button>

<button type="button" class="m-2 btn btn-secondary" @onclick="@CallViewModel.OnRestartIceAsync">
    Restart ICE
</button>

<button type="button" class="m-2 btn btn-secondary" @onclick="@CallViewModel.OnToggleSpatialLayerAsync">
    @CallViewModel.SpatialLayerButtonText
</button>

@* Always rendered, never conditional. Removing the element when there is nothing to say moved
   everything below it, and voice activity made that happen with every phrase rather than only
   on a mute. A reserved line costs nothing and keeps the video still. *@
<p class="mx-4 text-muted" style="min-height: 1.5rem;">@CallViewModel.PeerMediaStatus</p>

<div class="mx-4 d-flex flex-wrap">
    @foreach (var mediaParameters in CallViewModel.MediaStreamParametersList)
    {
        <div class="p-2">
            <Media Stream="@mediaParameters.Stream" Label="@mediaParameters.Label" Hangup="@mediaParameters.Hangup"
                   VideoMuted="@mediaParameters.VideoMuted" AudioMuted="@mediaParameters.AudioMuted"
                   CameraType="@mediaParameters.CameraType"  ShowContols="@mediaParameters.ShowControls" />
        </div>
    }
</div>

