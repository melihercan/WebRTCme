<Project Sdk="Microsoft.NET.Sdk.Razor">

	<!--
	  One project, one assembly, one package, two implementations.

	  The middleware used to be three projects: a generic core, a Blazor UI layer and a MAUI UI
	  layer. They are now slices of a single multi-targeted assembly - net10.0 builds Core+Blazor,
	  each platform TFM builds Core+Maui - so a consumer references WebRTCme.Middleware and gets
	  whichever implementation matches what they are building. Same bait-and-switch WebRTCme.csproj
	  uses one layer down.
	-->

	<PropertyGroup>
		<TargetFrameworks>net10.0;net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.22621.0</TargetFrameworks>
		<RootNamespace>WebRTCme.Middleware</RootNamespace>
		<AssemblyName>WebRTCme.Middleware</AssemblyName>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<SingleProject>true</SingleProject>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">28.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.22621.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup>
		<Authors>melihercan</Authors>
		<Version>26.9.9</Version>
		<Description>Services layer between Blazor or .NET MAUI applications and the WebRTCme library.</Description>
		<Copyright>melihercan 2024</Copyright>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/melihercan/WebRTCme</PackageProjectUrl>
		<PackageIcon>me.png</PackageIcon>
		<RepositoryUrl>https://github.com/melihercan/WebRTCme/tree/master/WebRTCme.Middleware</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>WebRTC .NET Blazor MAUI Android iOS</PackageTags>
		<PackageReleaseNotes>New major release.</PackageReleaseNotes>
		<!-- Packages come from CI, never from a local build. -->
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
	</PropertyGroup>

	<!-- MAUI only on the platform TFMs; net10.0 is the plain Blazor slice. -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != ''">
		<UseMaui>true</UseMaui>
		<ImplicitUsings>enable</ImplicitUsings>
		<!--
		  Keep Blazor Hybrid out of the graph entirely. The Razor SDK plus UseMaui makes MAUI add
		  Microsoft.AspNetCore.Components.WebView.Maui implicitly, and that one package causes
		  both of this layout's problems: its targets glob **\*.razor into every MAUI slice, and
		  its blazor.modules.json is claimed at the same target path by every Razor-SDK project in
		  the graph, which is a hard error once there is more than one. Neither project hosts a
		  WebView, and the MAUI packages they do need are referenced explicitly below.
		-->
		<DisableMauiImplicitPackageReferences>true</DisableMauiImplicitPackageReferences>
		<!--
		  And no static web asset manifests either. The Razor SDK emits them per TFM even with no
		  wwwroot, and an app that ends up with both the net10.0 and the platform build of this
		  assembly gets two files claiming one destination name, which fails MSIX packaging.
		-->
		<StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
	</PropertyGroup>

	<!--
	  Each slice's markup has to stay out of the other slice's build, and <Remove> cannot do it:
	  the MAUI Blazor Hybrid targets glob **\*.razor into RazorComponent from a .targets imported
	  after this file, and honour nothing but DefaultItemExcludes.
	-->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != ''">
		<DefaultItemExcludes>$(DefaultItemExcludes);Blazor\**</DefaultItemExcludes>
	</PropertyGroup>
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == ''">
		<DefaultItemExcludes>$(DefaultItemExcludes);Maui\**</DefaultItemExcludes>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="Core\**\*.cs" />
		<!--
		  The connection layer is packed into this package rather than depended on - its projects
		  set IsPackable=false - so the packages it needs are declared here instead. WebRTCme is
		  the one real dependency, and it is now referenced directly so pack records it as such;
		  it used to reach consumers only through the connection layer, which is invisible to them.
		-->
		<ProjectReference Include="..\WebRTCme.Connection\WebRTCme.Connection\WebRTCme.Connection.csproj" PrivateAssets="all" />
		<ProjectReference Include="..\WebRTCme\WebRTCme.csproj" />
		<PackageReference Include="Refractored.MvvmHelpers" Version="1.6.2" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.9" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.9" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.9" />
		<PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.9" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.9" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.9" />
		<PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.80" />
		<PackageReference Include="System.Reactive" Version="6.1.0" />
		<PackageReference Include="Utilme.Result" Version="1.0.1" />
		<PackageReference Include="Utilme.SdpTransform" Version="1.0.0" />
		<PackageReference Include="WebsocketClientLite.PCL" Version="9.0.2" />
	</ItemGroup>

	<!--
	  Pack the connection layer's assemblies into lib/ beside the middleware. The filter is by
	  name because ReferenceCopyLocalPaths also carries WebRTCme and its bindings, which arrive
	  transitively and belong to the WebRTCme package, not this one.
	-->
	<PropertyGroup>
		<TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeConnectionAssemblies</TargetsForTfmSpecificBuildOutput>
	</PropertyGroup>

	<Target Name="IncludeConnectionAssemblies" DependsOnTargets="ResolveReferences">
		<ItemGroup>
			<BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)"
				Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference' and '%(Extension)' == '.dll' and $([System.String]::Copy('%(Filename)').StartsWith('WebRTCme.Connection'))" />
		</ItemGroup>
	</Target>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == ''">
		<Compile Include="Blazor\**\*.cs" />
		<!-- Private: the binding assemblies ship inside the WebRTCme package, not this one. -->
		<ProjectReference Include="..\WebRTCme.Bindings\WebRTCme.Bindings.Blazor\WebRTCme.Bindings.Blazor.csproj" PrivateAssets="all" />
		<PackageReference Include="Microsoft.AspNetCore.Components" Version="10.0.9" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.9" />
		<PackageReference Include="BlazorDialog" Version="4.1.0" />
		<PackageReference Include="Blazorme.StreamSaver" Version="1.0.1" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != ''">
		<!-- Everything but Platforms, which is per-TFM below. -->
		<Compile Include="Maui\**\*.cs" Exclude="Maui\Platforms\**" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.80" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.80" />
		<PackageReference Include="CommunityToolkit.Maui" Version="14.2.0" />
		<PackageReference Include="Microsoft.JSInterop" Version="10.0.9" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
		<Compile Include="Maui\Platforms\Android\**\*.cs" />
		<!-- Private: the binding assemblies ship inside the WebRTCme package, not this one. -->
		<ProjectReference Include="..\WebRTCme.Bindings\Maui\WebRTCme.Bindings.Maui.Android\WebRTCme.Bindings.Maui.Android.csproj" PrivateAssets="all" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
		<Compile Include="Maui\Platforms\iOS\**\*.cs" />
		<!-- Private: the binding assemblies ship inside the WebRTCme package, not this one. -->
		<ProjectReference Include="..\WebRTCme.Bindings\Maui\WebRTCme.Bindings.Maui.iOS\WebRTCme.Bindings.Maui.iOS.csproj" PrivateAssets="all" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-maccatalyst'">
		<Compile Include="Maui\Platforms\MacCatalyst\**\*.cs" />
		<!-- Private: the binding assemblies ship inside the WebRTCme package, not this one. -->
		<ProjectReference Include="..\WebRTCme.Bindings\Maui\WebRTCme.Bindings.Maui.MacCatalyst\WebRTCme.Bindings.Maui.MacCatalyst.csproj" PrivateAssets="all" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.22621.0'">
		<Compile Include="Maui\Platforms\Windows\**\*.cs" />
		<!-- Private: the binding assemblies ship inside the WebRTCme package, not this one. -->
		<ProjectReference Include="..\WebRTCme.Bindings\Maui\WebRTCme.Bindings.Maui.Windows\WebRTCme.Bindings.Maui.Windows.csproj" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\me.png" Link="me.png">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
	</ItemGroup>

	<!--
	  Show the slice that is not being built in Solution Explorer anyway, so the whole middleware
	  stays browsable whichever TFM is active.
	-->
	<ItemGroup>
		<None Include="Blazor\**\*.cs;Maui\**\*.cs" Exclude="@(Compile);bin\**;obj\**" />
	</ItemGroup>
	<!--
	  Drop the .aar the Android SDK builds for this project. It re-emits the four
	  libjingle_peerconnection_so.so that arrive with libwebrtc.aar and nothing else, so it is
	  23MB of duplication - and two .aar carrying the same .so in one lib/ folder is a conflict
	  waiting to happen. The SDK adds it from _IncludeAarInNuGetPackage with no property to say
	  no, so it is removed immediately afterwards.
	-->
	<Target Name="DropRedundantGeneratedAar" AfterTargets="_IncludeAarInNuGetPackage">
		<ItemGroup>
			<TfmSpecificPackageFile Remove="$(OutputPath)$(TargetName).aar" />
		</ItemGroup>
	</Target>

</Project>
