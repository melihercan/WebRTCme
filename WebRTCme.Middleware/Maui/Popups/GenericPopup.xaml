<?xml version="1.0" encoding="utf-8" ?>
<views:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
           xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
           xmlns:views="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
           x:Class="WebRTCme.Middleware.Maui.Popups.GenericPopup">

    <!-- CommunityToolkit.Maui dropped Popup.Size; the content is sized instead. Leaving Size
         here made InitializeComponent throw, which killed the app whenever an error popup
         was shown.

         Both the background and the text colours are stated explicitly, and they have to be.
         The toolkit paints the popup white whatever the app theme is, while an unstyled Label
         takes its colour from the theme - so in a dark-themed app every error popup rendered
         as white text on white, with only the buttons visible. An error dialog that cannot
         show the error is worse than no dialog: it took a MediaSoup connection failure on
         Windows with it. -->
    <StackLayout WidthRequest="300" MinimumHeightRequest="300"
                 BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
        <StackLayout VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand">
            <StackLayout Orientation="Horizontal" HorizontalOptions="Center">
                <Image x:Name="Image" Aspect="AspectFit" HeightRequest="30" IsVisible="False"/>
                <Label x:Name="Title" FontSize="Title" FontAttributes="Bold" IsVisible="False"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
            </StackLayout>
            <Label x:Name="Text" Margin="0,20,0,0" IsVisible="False"
                   TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
            <Entry x:Name="Entry" Margin="0,10,0,0" IsVisible="False"
                   TextColor="{AppThemeBinding Light=Black, Dark=White}"
                   PlaceholderColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
            <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Margin="0,20">
                <Button x:Name="OkButton" Clicked="OkButton_Clicked" IsVisible="False"/>
                <Button x:Name="CancelButton" Clicked="CancelButton_Clicked" IsVisible="False"/>
            </StackLayout>
        </StackLayout>
    </StackLayout>
</views:Popup>