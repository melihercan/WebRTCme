<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
		<!-- Packed into WebRTCme or WebRTCme.Middleware, never shipped as a package of its own. -->
		<IsPackable>false</IsPackable>
    <TargetFramework>net10.0-ios</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <IsBindingProject>true</IsBindingProject>
    <SupportedOSPlatformVersion>12.4</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ObjcBindingApiDefinition Include="ApiDefinitions.cs" />
    <ObjcBindingCoreSource Include="StructsAndEnums.cs" />
  </ItemGroup>

  <!--
    An xcframework rather than a bare framework, so the binding carries the simulator slice
    (arm64 + x86_64) alongside the device one and the demo app can run on the iOS simulator.
    The dSYMs the artifact ships are not committed: they are 559MB against 37MB for the
    frameworks themselves, and the manifest's DebugSymbolsPath entries were removed with them
    so nothing points at a directory that is not there.

    Mac Catalyst deliberately stays on a plain framework; it has only one slice, and its
    Versions/A layout uses symlinks that a Windows checkout cannot represent.
  -->
  <ItemGroup>
    <NativeReference Include="WebRTC.xcframework">
      <Kind>Framework</Kind>
      <Frameworks></Frameworks>
      <LinkerFlags></LinkerFlags>
      <WeakFrameworks></WeakFrameworks>
      <ForceLoad>False</ForceLoad>
      <NeedsGccExceptionHandling>False</NeedsGccExceptionHandling>
      <IsCxx>False</IsCxx>
      <SmartLink>False</SmartLink>
    </NativeReference>
  </ItemGroup>
</Project>
