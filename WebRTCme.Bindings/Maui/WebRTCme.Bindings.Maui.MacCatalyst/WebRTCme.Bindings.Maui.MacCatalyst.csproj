<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
		<!-- Packed into WebRTCme or WebRTCme.Middleware, never shipped as a package of its own. -->
		<IsPackable>false</IsPackable>
    <TargetFramework>net10.0-maccatalyst</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <IsBindingProject>true</IsBindingProject>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!--
    Same Objective-C API surface as the iOS binding, over a WebRTC build that carries Mac
    Catalyst slices (x86_64 and arm64). The iOS binding keeps its own iOS-only framework so
    that platform is unaffected.
  -->
  <ItemGroup>
    <ObjcBindingApiDefinition Include="ApiDefinitions.cs" />
    <ObjcBindingCoreSource Include="StructsAndEnums.cs" />
  </ItemGroup>

  <ItemGroup>
    <NativeReference Include="WebRTC.framework">
      <Kind>Framework</Kind>
      <Frameworks></Frameworks>
      <LinkerFlags></LinkerFlags>
      <WeakFrameworks></WeakFrameworks>
      <ForceLoad>False</ForceLoad>
      <NeedsGccExceptionHandling>False</NeedsGccExceptionHandling>
      <IsCxx>False</IsCxx>
      <SmartLink>False</SmartLink>
    </NativeReference>
  </ItemGroup>
</Project>
