<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <!-- Every P/Invoke here is source-generated by [LibraryImport], which needs
         unsafe for the generated stubs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Unlike its Android, iOS and MacCatalyst siblings this is not an MSBuild
    binding project: there is no Java or Objective-C to generate wrappers for.
    WebRtcInterop.dll exposes a flat C ABI, so the whole binding is P/Invoke.

    The DLLs come from the WebRtcNativeInteropWindows workflow in the
    WebRTCnative repository and live in native/win-x64/, the same way
    libwebrtc.aar and WebRTC.framework are handled for Android and iOS.

    Take only the files native/win-x64/README.md lists; the artifact also
    carries the build machine's debugger tooling. WebRtcInterop.dll absorbs the
    WebRTC code it uses but still links against the component build's absl,
    boringssl, protobuf and libc++, and those in turn need the Visual C++
    runtime, so the whole import closure ships alongside it.
  -->
  <ItemGroup>
    <None Include="native\win-x64\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
